# =============================================================================
# alsek — Variables d'environnement
# Copier ce fichier en `.env` (production / Docker) ou `.env.local` (dev local)
# Ne JAMAIS committer de vrais identifiants.
# =============================================================================

# --- Serveur SMTP OVH (Zimbra / MX Plan) -------------------------------------
# Hôte SMTP OVH (TLS implicite sur le port 465)
SMTP_HOST=ssl0.ovh.net
# 465 = SSL/TLS implicite (recommandé) · 587 = STARTTLS (mettre SMTP_SECURE=false)
SMTP_PORT=465
# "true" pour le port 465, "false" pour le port 587
SMTP_SECURE=true
# Adresse complète de la boîte OVH utilisée pour l'envoi (expéditeur)
SMTP_USER=contact@alsek.fr
# Mot de passe de la boîte e-mail OVH
SMTP_PASS=change-me

# --- Destinataire des demandes du formulaire ---------------------------------
CONTACT_RECEIVER=contact@alsek.fr

# --- Tracking & Pixels (Chargés uniquement après consentement CNIL) ----------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# --- Next.js -----------------------------------------------------------------
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
